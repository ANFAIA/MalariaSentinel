#!/usr/bin/env bash
# MalariaSentinel Docker CLI helper.
#
# One-shot `malariasim` inside the image. No default pipeline.
# Prefer a long-lived box: docker compose -f docker/docker-compose.yml up -d
#
# Usage (from anywhere inside the repo):
#   ./docker/malariasim --help
#   ./docker/malariasim download --aoi ghana --datasets era5
#   ./docker/malariasim ingest --aoi ghana --year 2024 --month 6
#   ./docker/malariasim abm --aoi ghana --days 30
#   ./docker/malariasim bash
#
# Credentials (optional, for era5/modis/smap downloads) are read from the
# environment and forwarded: CDSAPI_URL, CDSAPI_KEY, EARTHDATA_TOKEN.
#
# Overrides:
#   IMAGE=malariasim:local (default)   — image tag to build/run
#   NO_BUILD=1                         — skip auto-build if image is missing
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="${IMAGE:-malariasim:local}"
DOCKERFILE="$REPO_ROOT/docker/Dockerfile"

# Build on first use unless NO_BUILD=1.
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    if [ "${NO_BUILD:-0}" = "1" ]; then
        echo "Image '$IMAGE' not found (NO_BUILD=1). Build it with:" >&2
        echo "  docker build -f $DOCKERFILE -t $IMAGE $REPO_ROOT" >&2
        exit 1
    fi
    echo "Building $IMAGE (first run — this takes a few minutes) ..."
    docker build -f "$DOCKERFILE" -t "$IMAGE" "$REPO_ROOT"
fi

# Forward dataset credentials if present in the host environment.
env_args=()
for v in CDSAPI_URL CDSAPI_KEY EARTHDATA_TOKEN; do
    if [ -n "${!v:-}" ]; then
        env_args+=(-e "$v=${!v}")
    fi
done

# Interactive (TTY) when connected to a terminal; plain `-i` otherwise so
# the helper also works in scripts/CI.
tty_args=(-i)
if [ -t 0 ]; then
    tty_args+=(-t)
fi

# No args → tell user to start the idle box.
if [ "$#" -eq 0 ]; then
    echo "Idle container: docker compose -f docker/docker-compose.yml up -d" >&2
    echo "Then: docker exec -it malariasim malariasim <cmd>" >&2
    echo "Or one-shot: $0 ingest --aoi ghana --year 2024 --month 6" >&2
    exit 2
fi

# Entrypoint is passthrough. Prefix CLI unless already a real command.
case "$1" in
    bash|sh|zsh|pipeline|malariasim|sleep) ;;
    *) set -- malariasim "$@" ;;
esac

exec docker run --rm ${tty_args[@]:-} \
    "${env_args[@]}" \
    -v "$REPO_ROOT:/app" \
    -v malariasim-venv:/app/.venv \
    "$IMAGE" "$@"