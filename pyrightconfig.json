{
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "mal-commonlib/src",
    "mal-core/src",
    "mal-execution/src",
    "mal-execution/scripts",
    "mal-data-explorer",
    "agents/janus/src"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "**/.venv",
    "**/runs"
  ],
  "typeCheckingMode": "standard",
  "useLibraryCodeForTypes": true
}
